{
  "name": "web",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/web/src",
  "projectType": "application",
  "tags": [],
  "namedInputs": {
    "default": [
      "{projectRoot}/**/*",
      "{workspaceRoot}/package.json",
      "{workspaceRoot}/tsconfig.base.json",
      "{workspaceRoot}/eslint.config.mjs",
      "{workspaceRoot}/orval.config.ts",
      "{workspaceRoot}/.dockerignore"
    ]
  },
  "targets": {
    "generate-api": {
      "executor": "nx:run-commands",
      "dependsOn": [
        {
          "projects": ["api"],
          "target": "openapi"
        }
      ],
      "outputs": ["{workspaceRoot}/apps/web/src/shared/api/generated"],
      "options": {
        "command": "orval --config orval.config.ts",
        "cwd": "."
      }
    },
    "container": {
      "cache": false,
      "executor": "nx:run-commands",
      "options": {
        "command": "docker build --build-arg APP_REVISION=0000000000000000000000000000000000000000 --build-arg VITE_API_BASE_URL=http://localhost:3000/api --file apps/web/Dockerfile --tag vytruve-web:local ."
      }
    }
  }
}
