{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist/out-tsc",
    "lib": ["es2022", "es2022.intl"],
    "module": "commonjs",
    "moduleResolution": "bundler",
    "target": "es2021",
    "types": ["jest", "node"]
  },
  "include": [
    "jest.config.ts",
    "jest.config.cts",
    "src/**/*.ts",
    "src/**/*.d.ts"
  ]
}
