# API runtime
NODE_ENV=development
API_PORT=3000
WEB_ORIGIN=http://localhost:4200

# Browser-safe Web runtime
VITE_API_BASE_URL=http://localhost:3000/api

# Licensed design workflow — leave empty in committed guidance
SHADCNDESIGN_LICENSE_KEY=

# API security — local development only
JWT_SECRET=local-jwt-secret-at-least-32-characters
JWT_ISSUER=vytruve-api
JWT_AUDIENCE=vytruve-web

# PostgreSQL local development only
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
POSTGRES_DB=vytruve
POSTGRES_USER=vytruve
POSTGRES_PASSWORD=local-development-only

# MinIO local development only
MAX_SCAN_SIZE_BYTES=26214400
MINIO_ENDPOINT=127.0.0.1
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=vytruve-local
MINIO_SECRET_KEY=local-development-only
MINIO_BUCKET=vytruve-scans

# Printing provider — replace locally, never commit a real credential
PRINTING_API_BASE_URL=https://printing.example.invalid
PRINTING_API_KEY=local-provider-key-placeholder
PRINTING_API_TIMEOUT_MS=5000
