# API runtime
NODE_ENV=development
API_PORT=3000
WEB_ORIGIN=http://localhost:4200

# API security — local development only
JWT_SECRET=local-jwt-secret-at-least-32-characters
JWT_ISSUER=vytruve-api
JWT_AUDIENCE=vytruve-web

# PostgreSQL local development only
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
POSTGRES_DB=vytruve
POSTGRES_USER=vytruve
POSTGRES_PASSWORD=local-development-only

# MinIO local development only
MINIO_ACCESS_KEY=vytruve-local
MINIO_SECRET_KEY=local-development-only
